package dashboard

// Nexo IA · NX-10 (panel) — menú e inicio con la marca de Nexo. Sin la marca
// activa delegan en los componentes de Engram (NavTabs, DashboardHome), así
// components.templ no cambia.

// nexoNavTabs agrega la pestaña Conocimiento y traduce las etiquetas.
templ nexoNavTabs(activeTab string, isAdmin bool) {
	if NexoBrand() {
		<div role="tablist">
			@navTab("/dashboard/", nx("Dashboard"), "dashboard", activeTab)
			@navTab("/dashboard/kb", "Conocimiento", "kb", activeTab)
			@nexoProposalsTab(activeTab)
			@navTab("/dashboard/browser", nx("Browser"), "browser", activeTab)
			@navTab("/dashboard/projects", nx("Projects"), "projects", activeTab)
			@navTab("/dashboard/contributors", nx("Contributors"), "contributors", activeTab)
			if isAdmin {
				@navTab("/dashboard/admin", nx("Admin"), "admin", activeTab)
				@navTab("/dashboard/admin/service-accounts", "Cuentas de servicio", "service-accounts", activeTab)
			}
			if isAdmin || nexoAuditNavOn(ctx) {
				@navTab("/dashboard/admin/audit", "Auditoría", "audit", activeTab)
			}
		</div>
	} else {
		@NavTabs(activeTab, isAdmin)
	}
}

// nexoHome es el inicio con la marca de Nexo.
templ nexoHome(username string) {
	if NexoBrand() {
		<section class="hero-panel nexo-home">
			<div class="hero-copy">
				<h2>Hola, { username }</h2>
				<p class="hero-lead">Aquí ves la memoria que comparten los asistentes del equipo. Los estándares oficiales están en Conocimiento.</p>
				<p><a href="/dashboard/kb" class="nexo-btn nexo-btn-primary">Buscar en Conocimiento</a></p>
			</div>
			<div class="data-frame" id="dashboard-stats" hx-get="/dashboard/stats" hx-trigger="load" hx-swap="innerHTML">
				<p class="htmx-indicator terminal-note">Cargando estadísticas...</p>
			</div>
		</section>
	} else {
		@DashboardHome(username)
	}
}

// nexoProposalsTab es la pestaña Propuestas (K6, KP-13). La insignia con las
// propuestas por revisar se pide con htmx al cargar la página: vacía si quien
// mira no revisa ningún espacio o no hay pendientes.
templ nexoProposalsTab(activeTab string) {
	if activeTab == "proposals" {
		<a href="/dashboard/kb/proposals" role="tab" aria-selected="true">Propuestas<span hx-get="/dashboard/kb/proposals/badge" hx-trigger="load" hx-swap="outerHTML"></span></a>
	} else {
		<a href="/dashboard/kb/proposals" role="tab" aria-selected="false">Propuestas<span hx-get="/dashboard/kb/proposals/badge" hx-trigger="load" hx-swap="outerHTML"></span></a>
	}
}
