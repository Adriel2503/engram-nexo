package dashboard

// Nexo IA · SG-10 — página de cuentas de servicio del panel. Archivo propio
// de Nexo: components.templ no cambia. Todo el texto se escapa.

templ NexoServiceAccountsPage(p NexoSAPage) {
	<div class="nx-page nexo-sa">
		<header class="nx-head">
			<h1>Cuentas de servicio</h1>
			<p class="nx-hint">Identidades para CI y bots: publican en los espacios sin usar el token de una persona. Cada cuenta tiene una persona responsable.</p>
		</header>
		if p.Notice != "" {
			<div class="nx-note" role="status"><p>{ p.Notice }</p></div>
		}
		if p.Error != "" {
			<div class="nx-note nx-note-error" role="alert"><p>{ p.Error }</p></div>
		}
		if p.NewToken != "" {
			<section class="nx-panel" aria-labelledby="nx-sa-token-t">
				<h2 class="nx-h2" id="nx-sa-token-t">Token nuevo</h2>
				<p>{ p.NewTokenNote }</p>
				<p><code class="nexo-sa-token">{ p.NewToken }</code></p>
				<p class="nx-hint">Se muestra una sola vez. Cárguelo como variable secreta del CI (por ejemplo NEXO_TOKEN) y no lo pegue en tickets ni chats.</p>
			</section>
		}
		<section class="nx-panel" aria-labelledby="nx-sa-list-t">
			<h2 class="nx-h2" id="nx-sa-list-t">Cuentas</h2>
			<p class="nx-hint">
				if p.ShowAll {
					<a href={ templ.URL(nexoSAListURL(false)) }>Ver solo las habilitadas</a>
				} else {
					<a href={ templ.URL(nexoSAListURL(true)) }>Ver también las deshabilitadas</a>
				}
			</p>
			if len(p.Accounts) == 0 {
				<p class="nx-empty">No hay cuentas de servicio.</p>
			} else {
				<div class="nx-scroll">
					<table>
						<thead><tr><th>Cuenta</th><th>Estado</th><th>Responsable</th><th>Roles</th><th>Descripción</th></tr></thead>
						<tbody>
							for _, a := range p.Accounts {
								<tr>
									<td><a href={ templ.URL(nexoSAURL(a.Slug)) }>{ a.Slug }</a></td>
									<td><span class={ nexoSAChip(a.Enabled) }>{ nexoSAState(a.Enabled) }</span></td>
									<td>{ a.Owner }</td>
									<td>{ a.Roles }</td>
									<td>{ a.Description }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		if p.Selected != nil {
			@nexoSADetail(p, *p.Selected)
		}
		if p.CanManage {
			<section class="nx-panel" aria-labelledby="nx-sa-new-t">
				<h2 class="nx-h2" id="nx-sa-new-t">Crear cuenta de servicio</h2>
				<form method="post" action="/dashboard/admin/service-accounts" class="nx-create">
					<input type="hidden" name="csrf_token" value={ p.CSRF }/>
					<label for="nx-sa-slug">Nombre corto <span class="nx-hint">minúsculas, números y guiones</span><input id="nx-sa-slug" type="text" name="slug" placeholder="ci-lineamientos" required pattern="[a-z0-9][a-z0-9-]{1,62}" autocomplete="off"/></label>
					<label for="nx-sa-desc">Descripción<input id="nx-sa-desc" type="text" name="description" placeholder="Publica la wiki desde el pipeline" maxlength="500" autocomplete="off"/></label>
					<label for="nx-sa-owner">Responsable <span class="nx-hint">usuario de la persona a cargo</span><input id="nx-sa-owner" type="text" name="owner" required autocomplete="off"/></label>
					<div><button type="submit">Crear cuenta</button></div>
				</form>
				<p class="nx-hint">Después, el responsable del espacio le da el rol publicador (Conocimiento o engram nexo sa grant). Una cuenta de servicio nunca es responsable ni tiene rol de plataforma.</p>
			</section>
		}
	</div>
}

templ nexoSADetail(p NexoSAPage, d NexoSADetail) {
	<section class="nx-panel" aria-labelledby="nx-sa-detail-t">
		<h2 class="nx-h2" id="nx-sa-detail-t">{ d.Slug }</h2>
		<p><span class={ nexoSAChip(d.Enabled) }>{ nexoSAState(d.Enabled) }</span> Responsable: { d.Owner }. Creada por { d.CreatedBy } el { d.CreatedAt }.</p>
		if d.Description != "" {
			<p>{ d.Description }</p>
		}
		if d.Roles != "" {
			<p>Roles: { d.Roles }</p>
		} else {
			<p class="nx-hint">Sin roles: no puede publicar en ningún espacio todavía.</p>
		}
		if p.CanManage {
			<form method="post" action={ templ.URL(nexoSAAction(d.Slug, nexoSAToggleOp(d.Enabled))) }>
				<input type="hidden" name="csrf_token" value={ p.CSRF }/>
				if d.Enabled {
					<button type="submit" class="nexo-btn-secondary">Deshabilitar</button>
					<span class="nx-hint">Todos sus tokens se rechazan desde la siguiente petición.</span>
				} else {
					<button type="submit">Habilitar</button>
				}
			</form>
		}
		<h3>Tokens</h3>
		if len(d.Tokens) == 0 {
			<p class="nx-empty">Sin tokens.</p>
		} else {
			<div class="nx-scroll">
				<table>
					<thead><tr><th>Token</th><th>Nombre</th><th>Alcance</th><th>Vence</th><th>Estado</th><th>Último uso</th><th>Última acción (IP y cliente)</th><th>Acciones</th></tr></thead>
					<tbody>
						for _, t := range d.Tokens {
							<tr>
								<td>{ t.ID }</td>
								<td>{ t.Name }</td>
								<td>{ t.Scope }</td>
								<td>{ t.Expires }</td>
								<td>{ t.State }</td>
								<td>{ t.LastUsed }</td>
								<td>{ t.LastSeen }</td>
								<td>
									if p.CanTokens && t.Active {
										<form method="post" action={ templ.URL(nexoSAAction(d.Slug, "rotate")) }>
											<input type="hidden" name="csrf_token" value={ p.CSRF }/>
											<input type="hidden" name="token_id" value={ t.ID }/>
											<label>Gracia (min)<input type="number" name="grace_minutes" value="0" min="0" max="10080"/></label>
											<button type="submit" class="nexo-btn-secondary">Rotar</button>
										</form>
										<form method="post" action={ templ.URL(nexoSAAction(d.Slug, "revoke")) }>
											<input type="hidden" name="csrf_token" value={ p.CSRF }/>
											<input type="hidden" name="token_id" value={ t.ID }/>
											<button type="submit" class="nexo-btn-secondary">Revocar</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="nx-hint">Último uso: cualquier petición con el token. Última acción: la última subida, publicación o cambio registrado, con su IP y cliente.</p>
		}
		if p.CanTokens && d.Enabled {
			<form method="post" action={ templ.URL(nexoSAAction(d.Slug, "token")) } class="nx-create">
				<input type="hidden" name="csrf_token" value={ p.CSRF }/>
				<label for="nx-sa-tname">Nombre del token <span class="nx-hint">máquina o uso</span><input id="nx-sa-tname" type="text" name="name" placeholder="ci-github" autocomplete="off"/></label>
				<label for="nx-sa-tdays">Días de vida <span class="nx-hint">vacío = 90; 0 = sin caducidad (solo superadmin)</span><input id="nx-sa-tdays" type="number" name="expires_in_days" min="0"/></label>
				<label for="nx-sa-tscope">Alcance<select id="nx-sa-tscope" name="scope"><option value="write" selected>Escritura (publicar)</option><option value="read">Solo lectura</option></select></label>
				<div><button type="submit">Emitir token</button></div>
			</form>
		}
	</section>
}
